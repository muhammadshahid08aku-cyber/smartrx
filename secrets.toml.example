# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Community Cloud > App settings > Secrets.
# NEVER commit the real secrets.toml.

# Supabase: Project Settings > Database > Connection string > "Session pooler" (works over IPv4)
DATABASE_URL = "postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DEMO_PASSWORD = "choose-a-strong-password"   # password for the seeded admin / dr_demo / pharm_demo accounts
GROQ_API_KEY = ""                            # optional, enables patient explanations
